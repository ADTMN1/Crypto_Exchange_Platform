# ----------------------------------
# 1. NODE ENVIRONMENT
# ----------------------------------
# Set to 'production' for live deployment, 'development' for local testing
NODE_ENV=production

# ----------------------------------
# 2. SERVER CONFIGURATION
# ----------------------------------
# Port to run the backend server on
PORT=5000

# URL of your frontend (for password reset links, CORS, etc.)
FRONTEND_URL=https://primealfatrade.com
ALLOWED_ORIGINS=https://primealfatrade.com
CLIENT_URL=https://primealfatrade.com

# ----------------------------------
# 3. DATABASE CONFIGURATION (Supabase Postgres)
# ----------------------------------
# Supabase Connection Pooler URI (Dashboard → Project Settings → Database).
# Use Session mode (port 5432) for the transactional wallet code.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Database statement timeout in milliseconds (default: 30000 = 30 seconds)
# Prevents long-running queries from hanging the application
DATABASE_STATEMENT_TIMEOUT=30000

# ----------------------------------
# 4. REDIS CONFIGURATION
# ----------------------------------
# DEVELOPMENT ONLY: Local Redis URL
REDIS_URL=redis://localhost:6379

# PRODUCTION ONLY: Upstash Redis credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------
# 5. SECURITY CONFIGURATION
# ----------------------------------
# JWT SECRETS - THESE MUST BE LONG, RANDOM, AND SECRET!
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=

# Cookie secret - for signing cookies
COOKIE_SECRET=

# CSRF secret - for CSRF protection
CSRF_SECRET=

# ----------------------------------
# 6. EMAIL CONFIGURATION
# ----------------------------------
# SMTP configuration for sending emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ----------------------------------
# 7. GOOGLE OAUTH CONFIGURATION
# ----------------------------------
GOOGLE_CLIENT_ID=

# ----------------------------------
# 8. CLOUDINARY CONFIGURATION
# ----------------------------------
# For screenshot uploads
# Get your credentials from https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------
# 9. BINANCE CONFIGURATION
# ----------------------------------
BINANCE_REST_BASEURL=https://fapi.binance.com
BINANCE_WS_BASEURL=wss://fstream.binance.com/ws

# ----------------------------------
# 10. DEVELOPMENT-ONLY CONFIGURATION
# ----------------------------------
# THESE ARE ONLY USED WHEN NODE_ENV=development
# They are IGNORED in production!

# Initial USDT balance to give new users in development mode (for testing)
TEST_INITIAL_USDT=1000
